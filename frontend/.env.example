# Copy to .env and fill in once you deploy the backend somewhere real.
# Locally, the defaults in src/lib/socket.js already point at
# http://localhost:5000, so you can leave this file unused for dev.

VITE_SOCKET_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000/api

# The join-page URL that the host screen encodes into its QR code.
# Set this to your deployed frontend URL before the event, e.g.
# https://welcome2026.your-club-site.com
VITE_JOIN_URL=http://localhost:5173/
