# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000

# Password organizers use to log into /admin
ADMIN_PASSWORD=changeme123

# Any random long string, used to sign admin login tokens
JWT_SECRET=replace_with_a_long_random_string

# Comma-separated list of frontend origins allowed to connect
# e.g. http://localhost:5173,https://your-club-site.vercel.app
CLIENT_ORIGIN=http://localhost:5173
